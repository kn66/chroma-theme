  "Finite palettes indexed by variant and display class.")

(defun chroma-palette-get (&optional variant display-class)
  "Return palette data for VARIANT and DISPLAY-CLASS.

VARIANT defaults to `dark', and DISPLAY-CLASS defaults to
`true-color'.  Signal `user-error' when the requested palette does not
exist.  The returned value is constant data and must not be modified."
  (let* ((selected-variant (or variant 'dark))
         (selected-class (or display-class 'true-color))
         (variant-data (alist-get selected-variant chroma-palettes))
         (palette (and variant-data
                       (alist-get selected-class variant-data))))
    (unless variant-data
      (user-error "Chroma has no %S variant" selected-variant))
    (unless palette
      (user-error "Chroma has no %S display palette for %S"
                  selected-class selected-variant))
    palette))

(defun chroma-palette-color (hue token &optional variant display-class)
  "Return the color for HUE and TOKEN.

Look up HUE and TOKEN in the finite palette selected by VARIANT and
DISPLAY-CLASS.  Signal `user-error' for an unknown hue or token."
  (let* ((palette (chroma-palette-get variant display-class))
         (hue-data (alist-get hue palette))
         (color (and hue-data (alist-get token hue-data))))
    (unless hue-data
      (user-error "Chroma palette has no %S hue" hue))
    (unless color
      (user-error "Chroma %S palette has no %S token" hue token))
    color))

(provide 'chroma-palette)

